---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { postcards } from "../data/postcards.ts";

// Astro optimizes images imported from src/, so the gallery picks them up here
// rather than reading them from public/ at runtime.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../postcards/*.{png,jpg,jpeg,webp}",
  { eager: true },
);

const MONTHS = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

// Dates carry the day so same-month cards sort predictably; only the month
// reaches the page.
const DATE = /^\d{4}-\d{2}-\d{2}$/;
// Files named YYYYMMDD-... must agree with their date, so a copied entry that
// kept the wrong day fails here rather than quietly sorting to the wrong spot.
const DATED_FILE = /^(\d{4})(\d{2})(\d{2})-/;

function monthYear(date: string) {
  const [year, month] = date.split("-");
  return `${MONTHS[Number(month) - 1]} ${year}`;
}

const entries = await Promise.all(
  [...postcards]
    .sort((a, b) => b.date.localeCompare(a.date))
    .map(async (card) => {
      if (!DATE.test(card.date)) {
        throw new Error(
          `postcards.ts has date "${card.date}" for ${card.file}; expected YYYY-MM-DD.`,
        );
      }
      const named = DATED_FILE.exec(card.file);
      if (named) {
        const fromName = `${named[1]}-${named[2]}-${named[3]}`;
        if (fromName !== card.date) {
          throw new Error(
            `${card.file} is named for ${fromName} but its date is ${card.date}.`,
          );
        }
      }
      const image = files[`../postcards/${card.file}`]?.default;
      if (!image) {
        throw new Error(
          `postcards.ts lists ${card.file}, but src/postcards/${card.file} is missing.`,
        );
      }
      // The overlay swaps this in on click, so it is generated but not rendered.
      const full = await getImage({ src: image, width: 1200, format: "webp" });
      return { ...card, image, full: full.src };
    }),
);

// Entries are already newest-first, so grouping keeps years in descending order.
const byYear = new Map<string, typeof entries>();
for (const entry of entries) {
  const year = entry.date.slice(0, 4);
  const bucket = byYear.get(year);
  if (bucket) bucket.push(entry);
  else byYear.set(year, [entry]);
}
const years = [...byYear.keys()];
---

<Base
  title="Postcards — Haewoon Kwak"
  description="Places Haewoon Kwak has been, drawn as illustrations."
  wide
>
  <header class="postcard-hero">
    <div>
      <p class="eyebrow">Visual field notes</p>
      <h1 class="page-title">Postcards</h1>
      <p class="intro">Places I have been, redrawn as illustrations.</p>
    </div>
    <p class="archive-meta">
      <strong>{entries.length}</strong>
      <span>illustrations<br />{years.at(-1)}–{years[0]}</span>
    </p>
  </header>

  <nav class="year-index" aria-label="Years">
    {years.map((year) => <a href={`#y${year}`}>{year}</a>)}
  </nav>

  {years.map((year) => (
    <section class="year">
      <h2 class="year-heading" id={`y${year}`}>
        <span>{year}</span>
        <span class="year-count">{byYear.get(year)!.length} postcards</span>
      </h2>
      <ul class="gallery">
        {byYear.get(year)!.map(({ image, full, place, date, note, noteEn }) => (
        <li>
          <button
            type="button"
            class="shot"
            data-full={full}
            data-place={place}
            data-when={monthYear(date)}
            data-note={note}
            data-note-en={noteEn}
          >
            <Image src={image} alt={noteEn || place} widths={[300, 600]} sizes="(max-width: 699px) 45vw, 280px" />
          </button>
          <p class="caption">
            <span class="where">{place}</span>
            <span class="when">{monthYear(date)}</span>
            {note && <span class="note" lang="ko">{note}</span>}
            {noteEn && <span class="note-en">{noteEn}</span>}
          </p>
        </li>
      ))}
      </ul>
    </section>
  ))}

  <dialog class="lightbox" aria-label="Postcard">
    <button type="button" class="close" aria-label="Close">&times;</button>
    <button type="button" class="step prev" aria-label="Previous postcard">&#8249;</button>
    <button type="button" class="step next" aria-label="Next postcard">&#8250;</button>
    <figure>
      <img alt="" />
      <figcaption>
        <span class="where"></span>
        <span class="when"></span>
        <span class="note" lang="ko"></span>
        <span class="note-en"></span>
      </figcaption>
    </figure>
  </dialog>
</Base>

<style>
  :global(main.wide) {
    max-width: 1080px;
  }

  .postcard-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: end;
    padding: 44px 0 64px;
    border-bottom: 1px solid #b9c8d4;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #d43c57;
    font-size: 12px;
    font-weight: 600;
    line-height: normal;
    text-transform: uppercase;
  }

  .page-title {
    margin: 0;
    color: #0b1f33;
    font-size: 64px;
    font-weight: 650;
    line-height: normal;
  }

  .intro {
    max-width: 520px;
    margin: 22px 0 0;
    color: #506174;
    font-size: 18px;
    line-height: 1.5;
  }

  .archive-meta {
    display: flex;
    gap: 8px;
    align-items: center;
    min-width: 120px;
    margin: 0;
    padding-left: 20px;
    border-left: 3px solid #d43c57;
    color: #68798a;
    font-size: 12px;
    line-height: 1.5;
  }

  .archive-meta strong {
    color: #0b1f33;
    font-size: 32px;
    font-weight: 650;
    line-height: normal;
  }

  :global(.year-index) {
    gap: 0;
    margin: 32px 0 72px;
    padding: 6px;
    background: #0b1f33;
  }

  :global(.year-index a) {
    min-width: 64px;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    line-height: normal;
    text-align: center;
  }

  :global(.year-index a:hover) {
    background: #315ff4;
    border-bottom-color: transparent;
    color: #ffffff;
  }

  :global(.year-heading) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 24px;
    padding-bottom: 14px;
    border-bottom-color: #b9c8d4;
    color: #0b1f33;
    font-size: 32px;
    font-weight: 650;
    line-height: normal;
  }

  .year-count {
    color: #7b8998;
    font-size: 12px;
    font-weight: 500;
    line-height: normal;
    text-transform: uppercase;
  }

  :global(.year + .year) {
    margin-top: 80px;
  }

  :global(.gallery) {
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 24px;
    margin-bottom: 0;
  }

  :global(.gallery > li) {
    overflow: hidden;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid #cbd7e0;
    box-shadow: 5px 5px 0 rgba(49, 95, 244, 0.06);
  }

  :global(.shot) {
    border-radius: 0;
    border-bottom: 1px solid #cbd7e0;
  }

  :global(.shot img) {
    transition: filter 160ms ease, transform 160ms ease;
  }

  :global(.shot:hover img) {
    filter: saturate(1.08) contrast(1.02);
    opacity: 1;
    transform: scale(1.015);
  }

  :global(.caption) {
    margin: 0;
    padding: 16px;
    color: #506174;
    font-size: 12px;
    line-height: 1.5;
  }

  :global(.caption .where) {
    display: block;
    color: #0b1f33;
    font-size: 16px;
    font-weight: 650;
    line-height: 1.5;
  }

  :global(.caption .when) {
    display: block;
    margin: 2px 0 12px;
    color: #d43c57;
    font-size: 12px;
    font-weight: 600;
    line-height: normal;
    text-transform: uppercase;
  }

  :global(.caption .note) {
    color: #405469;
    font-size: 14px;
    line-height: 1.5;
  }

  :global(.caption .note-en) {
    margin-top: 4px;
    color: #7b8998;
    font-size: 12px;
    line-height: 1.5;
  }

  :global(.lightbox::backdrop) {
    background: rgba(5, 18, 30, 0.94);
  }

  :global(.lightbox) {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    background: rgba(5, 18, 30, 0.94);
  }

  :global(.lightbox figcaption) {
    color: #edf3f7;
    font-size: 14px;
    line-height: 1.5;
  }

  :global(.lightbox .close),
  :global(.lightbox .step) {
    color: #ffffff;
  }

  @media (max-width: 760px) {
    .postcard-hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 28px 0 48px;
    }

    .page-title {
      font-size: 48px;
    }

    .archive-meta {
      justify-self: start;
    }

    :global(.year-index) {
      margin-bottom: 56px;
    }

    :global(.gallery) {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 14px;
    }
  }

  @media (max-width: 440px) {
    :global(.caption) {
      padding: 14px;
    }

    :global(.caption .where) {
      font-size: 14px;
    }

    :global(.caption .note) {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.shot img) {
      transition: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox")!;
  const shots = [...document.querySelectorAll<HTMLButtonElement>("button.shot")];
  const img = dialog.querySelector("img")!;
  const where = dialog.querySelector<HTMLElement>(".where")!;
  const when = dialog.querySelector<HTMLElement>(".when")!;
  const note = dialog.querySelector<HTMLElement>(".note")!;
  const noteEn = dialog.querySelector<HTMLElement>(".note-en")!;

  let current = 0;

  function show(index: number) {
    current = (index + shots.length) % shots.length;
    const shot = shots[current];
    const alt = shot.querySelector("img")?.alt ?? "";
    img.src = shot.dataset.full!;
    img.alt = alt;
    where.textContent = shot.dataset.place ?? "";
    when.textContent = shot.dataset.when ?? "";
    note.textContent = shot.dataset.note ?? "";
    noteEn.textContent = shot.dataset.noteEn ?? "";
  }

  shots.forEach((shot, index) => {
    shot.addEventListener("click", () => {
      show(index);
      dialog.showModal();
    });
    // Warm the full-size image so opening the overlay is not a blank beat.
    shot.addEventListener("pointerenter", () => {
      const warm = new Image();
      warm.src = shot.dataset.full!;
    }, { once: true });
  });

  dialog.querySelector(".close")!.addEventListener("click", () => dialog.close());
  dialog.querySelector(".prev")!.addEventListener("click", () => show(current - 1));
  dialog.querySelector(".next")!.addEventListener("click", () => show(current + 1));

  // Clicking the backdrop (the dialog element itself, outside the figure) closes.
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog.addEventListener("keydown", (event) => {
    if (event.key === "ArrowRight") { event.preventDefault(); show(current + 1); }
    if (event.key === "ArrowLeft") { event.preventDefault(); show(current - 1); }
    // <dialog> closes itself on Escape; this keeps that true where a host
    // window swallows the key before the default action runs.
    if (event.key === "Escape") dialog.close();
  });

  // Return focus to the thumbnail that opened the overlay.
  dialog.addEventListener("close", () => shots[current]?.focus());
</script>

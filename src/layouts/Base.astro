---
// Site shell: <head>, fonts and the shared stylesheet.
// Page content is slotted into <main>.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const tabs = [
  { href: "/", label: "Home" },
  { href: "/photos", label: "Photos" },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Spectral:ital,wght@0,500;1,400&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Spectral:ital,wght@0,500;1,400&display=swap" />
  </noscript>
  <style is:global>
    :root {
      --paper: #fdfcf9;
      --ink: #1a1a1a;
      --ink-soft: #525252;
      --ink-faint: #a3a3a3;
      --rule: #ece4d2;
      --accent: oklch(0.55 0.20 250);
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 17px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 48px 24px;
    }
    main {
      max-width: 560px;
      width: 100%;
    }
    .photo {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      display: block;
      margin: 0 0 28px;
    }
    h1 {
      font-family: "Spectral", "Newsreader", Georgia, serif;
      font-weight: 500;
      font-size: 40px;
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin: 0 0 8px;
    }
    .role {
      color: var(--ink-soft);
      margin: 0 0 28px;
      font-size: 15px;
    }
    .bio {
      color: var(--ink-soft);
      margin: 0 0 28px;
    }
    .bio em {
      font-family: "Spectral", serif;
      font-style: italic;
      font-weight: 400;
    }
    .section-label {
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin: 0 0 16px;
    }
    .work {
      list-style: none;
      margin: 0 0 28px;
      padding: 0;
    }
    .work li + li { margin-top: 18px; }
    .work a {
      color: var(--ink);
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1px dotted var(--ink-faint);
      padding-bottom: 1px;
    }
    .work a:hover { color: var(--accent); border-bottom-color: var(--accent); }
    .work .venue {
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
      font-size: 12px;
      color: var(--ink-faint);
      white-space: nowrap;
    }
    .work .note {
      display: block;
      color: var(--ink-soft);
      font-size: 15px;
      margin-top: 2px;
    }
    a {
      color: var(--accent);
      text-decoration: underline;
      text-decoration-color: color-mix(in oklch, var(--accent) 30%, transparent);
      text-underline-offset: 2px;
    }
    a:hover { text-decoration-color: var(--accent); }
    .scholar-line {
      color: var(--ink-soft);
      font-size: 14px;
      margin: 0 0 28px;
    }
    .scholar-line a {
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px dotted var(--ink-faint);
      padding-bottom: 1px;
    }
    .scholar-line a:hover { border-bottom-color: var(--accent); color: var(--accent); }
    .scholar-line strong { font-variant-numeric: tabular-nums; font-weight: 600; }
    .scholar-line .sep { color: var(--ink-faint); margin: 0 4px; }
    .scholar-line .updated {
      margin-left: 6px;
      color: var(--ink-faint);
      font-size: 12px;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
    }
    nav.links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
      padding-top: 20px;
      border-top: 1px solid var(--rule);
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    nav.links a {
      color: var(--ink);
      text-decoration: none;
      padding: 4px 0;
    }
    nav.links a:hover { color: var(--accent); }
    nav.tabs {
      display: flex;
      gap: 20px;
      margin: 0 0 32px;
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    nav.tabs a {
      color: var(--ink-faint);
      text-decoration: none;
      padding-bottom: 3px;
      border-bottom: 1px solid transparent;
    }
    nav.tabs a:hover { color: var(--ink); }
    nav.tabs a[aria-current="page"] {
      color: var(--ink);
      border-bottom-color: var(--rule);
    }
    .page-title {
      font-family: "Spectral", "Newsreader", Georgia, serif;
      font-weight: 500;
      font-size: 32px;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin: 0 0 12px;
    }
    .gallery {
      list-style: none;
      margin: 0 0 28px;
      padding: 0;
    }
    .gallery li + li { margin-top: 44px; }
    .gallery figure { margin: 0; }
    .gallery img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 3px;
    }
    .gallery figcaption {
      margin-top: 10px;
      font-size: 14px;
      color: var(--ink-soft);
    }
    .gallery .where { font-weight: 500; color: var(--ink); }
    .gallery .when {
      font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
      font-size: 12px;
      color: var(--ink-faint);
      margin-left: 8px;
    }
    .gallery .note { display: block; margin-top: 2px; }
    footer {
      margin-top: 40px;
      font-size: 12px;
      color: var(--ink-faint);
      font-family: "IBM Plex Mono", ui-monospace, monospace;
    }
    @media (max-width: 480px) {
      .work .venue {
        display: block;
        margin-top: 3px;
      }
      .work .venue .sep { display: none; }
    }
  </style>
</head>
<body>
  <main>
    <nav class="tabs" aria-label="Sections">
      {tabs.map((tab) => (
        <a href={tab.href} aria-current={here === tab.href ? "page" : undefined}>{tab.label}</a>
      ))}
    </nav>
    <slot />

    <footer>
      &copy; Haewoon Kwak
    </footer>
  </main>
</body>
</html>
